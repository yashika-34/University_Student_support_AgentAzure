# Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas / Local Connection URI

MONGODB_URI=mongodb://localhost:27017/uniassist_db

# JSON Web Token Configuration

JWT_SECRET=super_secret_uniassist_jwt_key_987654321
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_uniassist_refresh_key_123456789
JWT_REFRESH_EXPIRES_IN=7d

# Azure OpenAI Configuration

AZURE_OPENAI_ENDPOINT=https://universitystudentsuppor-resource.openai.azure.com/

AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Search Configuration (Optional)

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key_here
AZURE_SEARCH_INDEX_NAME=university-knowledge-index
